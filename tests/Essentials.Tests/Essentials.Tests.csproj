<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server tests: the pure core and the settings are compiled in directly. Set RAMJET_HOME to the engine build output (the folder that
       holds dotnet/Mc.Scripting.Api.dll). No NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Mc.Scripting.Essentials.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Core/**/*.cs" />
    <Compile Include="../../src/Settings/**/*.cs" />
    <Reference Include="Mc.Scripting.Api">
      <HintPath>$(RAMJET_HOME)/dotnet/Mc.Scripting.Api.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
